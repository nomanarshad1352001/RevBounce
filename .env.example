# ─────────────────────────────────────────────────────────────
# RevBounce — environment
# Copy to .env and adjust. The demo build runs entirely on an
# in-memory store, so DATABASE_URL/REDIS_URL are optional and
# only used if you later swap the store for Prisma/Redis.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secrets — MUST be rotated in production
REVBOUNCE_SECRET=replace-with-64-char-random-string
ENCRYPTION_KEY=replace-with-32-byte-key-for-aes-256-gcm

# Optional infra (not required in dummy mode)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://127.0.0.1:6379

# Billing (mock provider used when keys are absent)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / lead delivery defaults
MAILCHIMP_API_KEY=
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Trackers
EVERFLOW_NID=
TWYNE_KEY=
